{
  "name": "secbench-ts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Artefato experimental SecBench-TS — corpus TypeScript com falhas documentadas para comparação SAST vs LLM",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:corpus": "tsx tools/build-corpus.ts",
    "test": "vitest run",
    "test:proof": "vitest run tests/proof",
    "scan:semgrep": "tsx scripts/scan-semgrep.ts",
    "scan:codeql": "tsx scripts/scan-codeql.ts",
    "scan:njsscan": "tsx scripts/scan-njsscan.ts",
    "scan:eslint": "tsx scripts/scan-eslint.ts",
    "scan:llm": "tsx tools/llm/run-llm.ts",
    "docker:build": "docker compose -f docker/compose.yml build semgrep codeql",
    "docker:versions": "npm run docker:build && tsx docker/generate-versions.ts",
    "measurement:prepare": "tsx tools/prepare-measurement.ts",
    "measurement:verify": "tsx tools/prepare-measurement.ts --verify-only",
    "normalize": "tsx tools/normalize.ts",
    "score": "tsx tools/score.ts",
    "check:asymmetry": "tsx tools/asymmetry-check.ts",
    "verify": "npm run build:corpus && npm test"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "dayjs": "^1.11.13",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "js-yaml": "^3.14.1",
    "moment": "^2.30.1",
    "node-serialize": "^0.0.4",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^3.12.5",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "eslint-plugin-security": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
