# CodeQL CLI bundle — version pinned at build time; no runtime downloads.
FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

ARG CODEQL_BUNDLE_TAG=codeql-bundle-v2.26.3
ARG CODEQL_BUNDLE_URL=https://github.com/github/codeql-action/releases/download/codeql-bundle-v2.26.3/codeql-bundle-linux64.tar.zst
# Node is required for TypeScript extraction during database create.
ARG NODE_MAJOR=22

ENV CODEQL_HOME=/opt/codeql
ENV PATH="${CODEQL_HOME}/bin:${PATH}"
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl zstd gnupg \
  && curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/* \
  && curl -fsSL "${CODEQL_BUNDLE_URL}" -o /tmp/codeql-bundle.tar.zst \
  && mkdir -p "${CODEQL_HOME}" \
  && tar --use-compress-program=unzstd -xf /tmp/codeql-bundle.tar.zst -C "${CODEQL_HOME}" \
  && mv "${CODEQL_HOME}/codeql" "${CODEQL_HOME}/bin" \
  && rm /tmp/codeql-bundle.tar.zst \
  && node --version \
  && codeql version

WORKDIR /work
